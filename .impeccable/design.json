  "narrative": {
    "northStar": "A personal commonplace book",
    "overview": "Green endpapers sit beside an off-white reading ground. Forest ink, open space, and serif titles give short notes and long essays the same care. Small sans-serif controls keep the writing easy to find.\n\nDark mode uses a soft green-black ground with pale text. Both themes keep the same page structure and quiet contrast.",
    "keyCharacteristics": [
      "Open post rows with fine rules.",
      "Serif writing with small sans-serif controls.",
      "Green tones in both light and dark themes."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Use the matching theme value for each color role. Keep the reading structure the same in both themes.",
        "section": "colors"
      },
      {
        "name": "The Open Page Rule",
        "body": "Separate post entries with space and a fine bottom rule. Keep each entry on the reading ground.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the theme color roles for text, grounds, rules, and controls.",
      "Do keep serif titles and reading text distinct from sans-serif controls.",
      "Do preserve visible keyboard focus and the full mobile navigation."
    ],
    "donts": [
      "Don't box the post feed into raised cards.",
      "Don't add entrance motion or remove the reduced-motion rule.",
      "Don't place the subscription form before the writing on the home page."
    ]
  }
