#!/bin/bash
# =============================================================
# write-prompt - Daily private writing nudge for kathleencelmins.xyz
#
# Triggered by launchd at your chosen time.
# Shows a notification, and if you click it, opens the voice inbox.
# =============================================================

# Resolve the repo root from this script's own location, so the tools keep
# working wherever the repo lives (it moved once already, into the Glitch
# workspace tree, which silently broke every one of these scripts).
SITE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORKBENCH_DIR="$SITE_DIR/writing-workbench"
VOICE_INBOX="$WORKBENCH_DIR/inbox/voice-inbox.md"

mkdir -p "$WORKBENCH_DIR/inbox" "$WORKBENCH_DIR/drafts" "$WORKBENCH_DIR/fragments" "$WORKBENCH_DIR/archive"

TODAY=$(date +%Y-%m-%d)

if [[ ! -f "$VOICE_INBOX" ]]; then
  cat > "$VOICE_INBOX" << EOF
# Voice Inbox

EOF
fi

if ! grep -q "^## ${TODAY}$" "$VOICE_INBOX"; then
  cat >> "$VOICE_INBOX" << EOF

## ${TODAY}

Topic:

What happened?

What I noticed:

Why it matters:

The line I want to remember:

Possible title:
EOF
fi

# Show a macOS notification.
osascript -e 'display notification "5 minutes. One thought. Private first." with title "Time to write" subtitle "Open the voice inbox?" sound name "Purr"'

RESPONSE=$(osascript -e '
tell application "System Events"
  display dialog "Start in the private voice inbox.

Capture the raw thought first. Publishing is a separate decision." buttons {"Not today", "Open inbox"} default button "Open inbox" with title "Time to write" with icon note giving up after 300
end tell
' 2>/dev/null)

if echo "$RESPONSE" | grep -q "Open inbox"; then
  open -a "Antigravity" "$VOICE_INBOX" || ${EDITOR:-code} "$VOICE_INBOX"
fi
