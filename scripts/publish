#!/bin/bash
# =============================================================
# publish — Commit and push public writing changes
#
# Usage:
#   publish              → commits public writing changes and pushes
#   publish "some note"  → adds a custom commit message
# =============================================================

# Resolve the repo root from this script's own location, so the tools keep
# working wherever the repo lives (it moved once already, into the Glitch
# workspace tree, which silently broke every one of these scripts).
SITE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SITE_DIR" || exit 1

# Check for public writing changes only
UNTRACKED_CONTENT=$(git ls-files --others --exclude-standard content/)
if git diff --quiet -- content/ && git diff --cached --quiet -- content/ && [[ -z "$UNTRACKED_CONTENT" ]]; then
  echo ""
  echo "  ✨ Nothing new to publish. You're up to date."
  echo ""
  exit 0
fi

# Show what's changed
echo ""
echo "  📝 Changes to publish:"
echo ""
git status --short content/ | sed 's/^/  /'
echo ""

# Commit message
if [[ -n "$1" ]]; then
  MSG="$*"
else
  # Auto-generate from changed files
  CHANGED=$(git diff --name-only content/ 2>/dev/null | head -1)
  NEW=$(git ls-files --others --exclude-standard content/ 2>/dev/null | head -1)
  
  if [[ -n "$NEW" ]]; then
    BASENAME=$(basename "$NEW" .md)
    MSG="New post: ${BASENAME}"
  elif [[ -n "$CHANGED" ]]; then
    BASENAME=$(basename "$CHANGED" .md)
    MSG="Update: ${BASENAME}"
  else
    MSG="Update writing"
  fi
fi

git add -A content/
git commit -m "$MSG" --quiet -- content/
echo "  ✅ Committed: $MSG"

if git push --quiet; then
  echo "  🚀 Pushed to GitHub — Vercel will deploy in ~30 seconds"
else
  echo "  ⚠️  Push failed. Your work is committed locally and safe."
fi
echo ""
